# Base de datos SQLite
DATABASE_URL=sqlite:///./inventario.db

# Seguridad JWT
JWT_SECRET_KEY=cambia-esta-clave-en-produccion-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# OpenTelemetry -> OpenObserve (http://<EC2_HOST>:5080/api/default)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=inventario-erp
OTEL_INFRA_SERVICE_NAME=inventario-erp-infra
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:5080/api/default
# Base64 de "usuario:password" de OpenObserve (ej. root@example.com:Complexpass#123)
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic cm9vdEBleGFtcGxlLmNvbTpDb21wbGV4cGFzcyMxMjM=

# Monitor de infraestructura
INFRA_SCRAPE_INTERVAL=10
HOST_LABEL=ec2-inventario-prod
